<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Verification Code</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f4f6f8;
        font-family:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        color: #334155;
        -webkit-font-smoothing: antialiased;
      }
      .email-wrapper {
        width: 100%;
        background-color: #f4f6f8;
        padding: 40px 16px;
      }
      .email-container {
        max-width: 540px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
      }
      .header {
        background-color: #0f172a;
        padding: 24px;
        text-align: center;
      }
      .header h1 {
        margin: 0;
        color: #ffffff;
        font-size: 18px;
        font-weight: 600;
        letter-spacing: 0.5px;
      }
      .content {
        padding: 32px 28px;
      }
      .greeting {
        font-size: 15px;
        font-weight: 600;
        margin: 0 0 12px 0;
        color: #0f172a;
      }
      .message {
        font-size: 14px;
        line-height: 1.6;
        margin: 0 0 24px 0;
        color: #475569;
      }
      .otp-card {
        background-color: #f8fafc;
        border: 1px dashed #cbd5e1;
        border-radius: 8px;
        padding: 24px;
        text-align: center;
        margin: 20px 0 24px 0;
      }
      .otp-code {
        font-family: 'Courier New', Courier, monospace;
        font-size: 34px;
        font-weight: 700;
        letter-spacing: 8px;
        color: #0f172a;
        margin: 0;
      }
      .otp-expiry {
        font-size: 12px;
        color: #64748b;
        margin-top: 10px;
      }
      .warning-box {
        background-color: #fef2f2;
        border-left: 4px solid #ef4444;
        padding: 12px 16px;
        font-size: 13px;
        line-height: 1.5;
        color: #991b1b;
        border-radius: 0 4px 4px 0;
      }
      .footer {
        background-color: #f8fafc;
        border-top: 1px solid #e2e8f0;
        padding: 20px 28px;
        text-align: center;
        font-size: 12px;
        color: #94a3b8;
        line-height: 1.5;
      }
    </style>
  </head>
  <body>
    <div class="email-wrapper">
      <div class="email-container">
        <!-- Brand / App Header -->
        <div class="header">
          <h1>Account Verification</h1>
        </div>

        <!-- Main Body -->
        <div class="content">
          <p class="greeting">Hello,</p>
          <p class="message">
            We received a request to verify your identity. Please use the following One-Time
            Password (OTP) to complete the verification process:
          </p>

          <!-- OTP Display Box -->
          <div class="otp-card">
            <div class="otp-code"><%= otp %></div>
            <div class="otp-expiry">
              This code will expire in <%= typeof expiryMinutes !== 'undefined' ? expiryMinutes : 3
              %> minutes.
            </div>
          </div>

          <!-- Security Notice -->
          <div class="warning-box">
            <strong>Security Notice:</strong> Never share this code with anyone. Our team will never
            ask for your verification code. If you did not make this request, you can safely ignore
            this email.
          </div>
        </div>

        <!-- Footer -->
        <div class="footer">
          This is an automated message. Please do not reply directly to this email.<br />
          &copy; <%= new Date().getFullYear() %> Healthcare Limited. All rights reserved.
        </div>
      </div>
    </div>
  </body>
</html>

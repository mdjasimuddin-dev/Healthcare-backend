model Payment {
  id       String        @unique @default(uuid())
  status   PaymentStatus @default(UNPAID)
  amount   Decimal       @db.Decimal(10, 2)
  currency String        @default("BDT")

  paymentGateway        String @default("bkash")
  marchantInvoiceNumber String @unique // Appointment Id

  bkashPaymentId  String? @unique
  bkashTrxId      String?
  payerReferences String?
  paidAt          String?

  gatewayResponse Json?

  refundTrxId  String?
  refundAmount Decimal?  @db.Decimal(10, 2)
  refundReason String?
  refundedAt   DateTime?

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now())

  @@map("payments")
}
